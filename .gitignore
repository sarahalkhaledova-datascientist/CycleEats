# --- raw data (too large, not ours to redistribute); keep the empty folder ---
data/raw/*
!data/raw/.gitkeep

# --- generated by the notebooks (recreated by running them) ---
*.pkl
data/processed/*
!data/processed/.gitkeep

# generated csv files saved next to the notebooks
notebooks/*.csv

